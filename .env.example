# Omaville's environment. Copy to .env and fill in what you need: `pnpm dev` reads .env on its own, and
# `pnpm start` (node build) reads it too. Never commit .env. Empty means unset.
#
# Local work needs none of this: `pnpm dev` runs from dev/snapshot.json with unsigned hooks (or scans the org into
# the database when GITHUB_TOKEN is set), and
# `pnpm dev:members` adds an invented members' city, signed in as "you".

# ---- the app's server (production: the Dockerfile sets HOST=0.0.0.0 and PORT=3000) ----
# the city's public address (needed behind Coolify's proxy, for sign-in and form posts)
# ORIGIN=https://city.example.org

# ---- the relay: the org's data ----
# reads the org: public repositories only for the public city; an org owner's token for the members' city (README: Token)
GITHUB_TOKEN=
# signs GitHub's webhooks to POST /hook (optional: unset, hooks are refused and the scans alone update the city)
CITY_WEBHOOK_SECRET=
# Bearer token for POST /scan, /snapshot and /backfill
CITY_SNAPSHOT_TOKEN=
# CITY_SCAN_EVERY=60                        # minutes between scans ("0": none; default 60 with a token)
# CITY_DATA=dev/snapshot.json               # a base file instead of scans (local work)
# CITY_CONFIG=city.config.json              # the one config file: the org and its layout
# CITY_INSECURE=1                           # accept unsigned hooks (local work only; on in dev)

# ---- Basecamp (the members' city: read only once sign-in is set up) ----
# an OAuth token of the city's Basecamp account, for the scan
BASECAMP_TOKEN=
# the secret path of Basecamp's webhooks: POST /hook/basecamp/<key>
CITY_BASECAMP_HOOK_KEY=

# ---- the database: the event log, the base snapshot, replay checkpoints, and sign-in's users and sessions ----
# Postgres (`pnpm db:start` runs the one in compose.yaml at this address; in Coolify, the URL of its Postgres
# resource); migrations in drizzle/ apply as the app starts. Unset in dev: an in-memory PGlite, fresh on every start. pglite:<folder> keeps a PGlite
# on disk (one process only).
DATABASE_URL=postgres://root:mysecretpassword@localhost:5432/local

# ---- sign-in (Better Auth; off unless the secret and one provider are set). Off, the city is public only: ----
# ---- no private repository, private webhook event or Basecamp data is read or kept ----
# e.g. `openssl rand -base64 32`
BETTER_AUTH_SECRET=
# the city's address, e.g. https://city.example.org (http://localhost:8080 in dev)
BETTER_AUTH_URL=
# a GitHub OAuth app; callback <BETTER_AUTH_URL>/api/auth/callback/github
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
# a 37signals Launchpad app; callback <BETTER_AUTH_URL>/api/auth/callback/basecamp
BASECAMP_CLIENT_ID=
BASECAMP_CLIENT_SECRET=

# ---- welcome comments on a first contribution (optional) ----
# CITY_WELCOME=1
# CITY_PUBLIC_URL=https://city.example.org
# CITY_COMMENT_TOKEN=                       # may comment on the org's pull requests

# ---- scripts ----
# CHROME=/path/to/chrome                    # for pnpm shots
